dev-repo: "git+https://github.com/mathiasbourgoin/creality-print-mcp.git"
depends: ["ocaml" {>= "5.1"} "dune" {>= "3.11"} "mcp-kit" {= "0.2.0"} "yojson"]
build: [["dune" "build" "@all"]]
