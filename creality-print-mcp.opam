opam-version: "2.0"
synopsis: "MCP tools for Creality Print, OrcaSlicer Remote API and Creality Hi LAN printing"
maintainer: "Mathias Bourgoin"
authors: ["Mathias Bourgoin"]
license: "MIT"
homepage: "https://github.com/mathiasbourgoin/creality-print-mcp"
